PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Neon gives you a DATABASE_URL similar to this.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Replace this with a long random secret before using the app seriously.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Only used by the seed script for predictable demo accounts.
SEED_ADMIN_PASSWORD=Admin@123
SEED_OWNER_PASSWORD=Owner@123
SEED_USER_PASSWORD=User@123
